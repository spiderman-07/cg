import tkinter as tk

root = tk.Tk()
root.title("Human Facial Expressions")

canvas = tk.Canvas(
    root,
    width=800,
    height=300,
    bg="white"
)
canvas.pack()

def draw_face(x, expression):

    # Face
    canvas.create_oval(
        x, 50,
        x + 150, 200,
        fill="yellow",
        outline="black",
        width=2
    )

    # Eyes
    canvas.create_oval(
        x + 35, 90,
        x + 55, 110,
        fill="black"
    )

    canvas.create_oval(
        x + 95, 90,
        x + 115, 110,
        fill="black"
    )

    if expression == "happy":

        canvas.create_arc(
            x + 35, 110,
            x + 115, 170,
            start=180,
            extent=180,
            style=tk.ARC,
            width=3
        )

        canvas.create_text(
            x + 75,
            220,
            text="Happy Face",
            font=("Arial", 12, "bold")
        )

    elif expression == "sad":

        canvas.create_arc(
            x + 35, 130,
            x + 115, 190,
            start=0,
            extent=180,
            style=tk.ARC,
            width=3
        )

        canvas.create_text(
            x + 75,
            220,
            text="Sad Face",
            font=("Arial", 12, "bold")
        )

    elif expression == "surprise":

        canvas.create_oval(
            x + 60, 130,
            x + 90, 160,
            outline="black",
            width=3
        )

        canvas.create_text(
            x + 75,
            220,
            text="Surprise Face",
            font=("Arial", 12, "bold")
        )

draw_face(50, "happy")
draw_face(300, "sad")
draw_face(550, "surprise")

root.mainloop()
